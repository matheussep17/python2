# Ignore build and dist folders
build/
dist/
build_release/
dist_release/
build_*/
dist_*/
.tmp/
*.log
*.tmp

# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# Local app data / databases
*.db
*.sqlite
*.sqlite3
licensing_server/data/
saas_server/data/

# App package cache directories
app/__pycache__/
app/frames/__pycache__/
app/ui/__pycache__/
app/pyinstaller_hooks/**/__pycache__/
app/runtime_hooks/**/__pycache__/

# PyInstaller files
*.spec

# Virtual environments
venv/
.venv/
.buildvenv/

# Local editor settings
.vscode/

# Node / frontend generated files
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# Local FFmpeg binaries for packaging
vendor/ffmpeg/bin/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
